@model List<RealEstate_Dapper_UI.Dtos.PopularLocationsDtos.ResultPopularLocationDtos>
@{
    ViewData["Title"] = "Popular Locations";
    Layout = "~/Views/Admin/Index.cshtml";
    var items = Model ?? new List<RealEstate_Dapper_UI.Dtos.PopularLocationsDtos.ResultPopularLocationDtos>();
    int count = 0;
}

<div class="page-head">
    <div>
        <p class="crumbs"><a href="/Dashboard/Index/">Dashboard</a> / Locations</p>
        <h1>Popular Locations</h1>
        <p>Cities featured on the home page.</p>
    </div>
    <a class="btn btn-primary" href="/PopularLocation/CreatePopularLocations"><i class="fa-solid fa-plus" aria-hidden="true"></i> New Popular Location</a>
</div>

<section class="card card-pad" aria-labelledby="list-title">
    <div class="table-toolbar">
        <h2 class="visually-hidden" id="list-title">Popular Locations</h2>
        <span class="count">@items.Count @(items.Count == 1 ? "record" : "records")</span>
    </div>
    @if (items.Any())
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th scope="col" class="idx">#</th>
                        <th scope="col">City Name</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        count++;
                        <tr>
                            <th scope="row" class="idx">@count</th>
                            <td class="title-cell">
                                <span class="row-flex" style="gap:.75rem;flex-wrap:nowrap">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img class="thumb" src="@item.ImageUrl" alt="" width="44" height="44" loading="lazy" style="border-radius:50%"> }
                                    <span>@item.CityName</span>
                                </span>
                            </td>
                            <td data-label="Actions"><div class="actions"><a href="/PopularLocation/DeletePopularLocations/@item.LocationID" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Delete</a><a href="/PopularLocation/UpdatePopularLocations/@item.LocationID" class="btn btn-sm btn-ghost"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Update</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
            <strong>No locations yet</strong>
            <p>Add a city with an image to feature it.</p>
        </div>
    }
</section>
