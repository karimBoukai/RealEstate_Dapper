@model List<RealEstate_Dapper_UI.Dtos.ProductDtos.GetProductsForAdsPageDtos>
@{
    ViewData["Title"] = "All sale & rent ads";
    Layout = "~/Views/Shared/_DefaultLayout.cshtml";
    var items = Model ?? new List<RealEstate_Dapper_UI.Dtos.ProductDtos.GetProductsForAdsPageDtos>();
}

<section class="page-hero">
    <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-hero-fade>
            <ol>
                <li><a href="/Default/Index/">Home</a></li>
                <li aria-current="page">Ads</li>
            </ol>
        </nav>
        <p class="eyebrow" data-hero-fade>Sale &amp; rent</p>
        <h1 data-hero-fade>All sale &amp; rent ads</h1>
        <p data-hero-fade>Every active listing from our estate agents.</p>
    </div>
</section>

<section class="section-tight" aria-labelledby="results-title">
    <div class="container">
        <div class="results-bar">
            <h2 class="results-count" id="results-title">@items.Count <span>@(items.Count == 1 ? "property" : "properties")</span></h2>
            <a class="btn btn-ghost btn-sm" href="/Default/Index/#search"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Search</a>
        </div>

        @if (items.Any())
        {
            <div class="card-grid">
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    <partial name="_PropertyCard" model='new PropertyCardModel(item.ProductID, item.Title, item.Price, item.Type, item.CategoryName, item.Address, item.District, item.City, item.CoverImage, ViewFormat.PropertyUrl(item.SlugUrl, item.Title, item.ProductID), i < 3)' />
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                <strong>No ads to show</strong>
                <p>There are no active listings right now. Please check back later.</p>
            </div>
        }
    </div>
</section>
