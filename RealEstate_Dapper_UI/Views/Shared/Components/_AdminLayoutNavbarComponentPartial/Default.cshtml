<header class="topbar">
    <button type="button" class="icon-btn" data-sidebar-toggle aria-controls="dash-sidebar" aria-expanded="true" aria-label="Toggle navigation">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <form class="topbar-search" role="search" onsubmit="return false;">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label class="visually-hidden" for="dash-search">Search</label>
        <input class="form-control" id="dash-search" type="search" placeholder="Search">
    </form>

    <div class="topbar-tools">
        <div class="dropdown">
            <button type="button" class="icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Messages">
                <i class="fa-regular fa-envelope" aria-hidden="true"></i><span class="dot" aria-hidden="true"></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end">
                <p class="dropdown-header">Messages</p>
                @for (var i = 0; i < 3; i++)
                {
                    <a href="#" class="dropdown-item">
                        <span class="avatar" aria-hidden="true">J</span>
                        <span><strong>Jhon send you a message</strong><small>15 minutes ago</small></span>
                    </a>
                }
                <hr class="dropdown-divider">
                <a href="#" class="dropdown-item" style="justify-content:center">See all message</a>
            </div>
        </div>
        <partial name="_DashboardTopbarTools" />
    </div>
</header>
