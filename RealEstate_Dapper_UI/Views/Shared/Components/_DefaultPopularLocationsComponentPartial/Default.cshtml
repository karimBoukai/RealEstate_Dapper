@model List<ResultPopularLocationDtos>
@{
    var items = Model ?? new List<ResultPopularLocationDtos>();
}
<section class="section" id="locations" aria-labelledby="locations-title">
    <div class="container">
        <div class="section-head center" data-reveal>
            <p class="eyebrow">Explore cities</p>
            <h2 class="section-title" id="locations-title">Popular <span class="serif">locations</span></h2>
        </div>

        @if (items.Any())
        {
            <ul class="location-grid" role="list">
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    // keep rows full on the 3-column grid: widen the first tile (n % 3 == 2) or the last one (n % 3 == 1)
                    var shape = items.Count % 3 == 2 && i == 0 ? "is-wide" : items.Count % 3 == 1 && items.Count > 1 && i == items.Count - 1 ? "is-full" : "";
                    <li class="location-tile @shape" data-reveal>
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="" loading="lazy" decoding="async" width="800" height="600">
                        }
                        <div class="location-meta">
                            <h3>@item.CityName</h3>
                            <span class="badge badge-glass">@item.PropertyCount Ad</span>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-state">
                <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                <strong>No locations to show yet</strong>
            </div>
        }
    </div>
</section>
