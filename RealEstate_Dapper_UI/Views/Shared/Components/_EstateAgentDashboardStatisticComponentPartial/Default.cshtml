@{
    var tiles = new (string Icon, string Label, object? Value)[]
    {
        ("fa-solid fa-bullhorn", "All Ads", ViewBag.AllProductCount),
        ("fa-solid fa-user-tag", "Your Ads", ViewBag.EmployeeByProductCount),
        ("fa-solid fa-circle-check", "Active Ads", ViewBag.ProductCountByStatusTrue),
        ("fa-solid fa-circle-pause", "Passive Ads", ViewBag.ProductCountByStatusFalse),
    };
}
<section class="grid grid-kpi" aria-label="Advert statistics">
    @foreach (var t in tiles)
    {
        var v = ViewFormat.Stat(t.Value);
        <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><i class="@t.Icon"></i></span>
            <div>
                <p class="kpi-label">@t.Label</p>
                <p class="kpi-value @(v == "—" ? "is-empty" : "")">@v</p>
            </div>
        </article>
    }
</section>
