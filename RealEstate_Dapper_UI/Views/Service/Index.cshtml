@model List<ResultServiceDtos>
@{
    ViewData["Title"] = "Services";
    Layout = "~/Views/Admin/Index.cshtml";
    var items = Model ?? new List<ResultServiceDtos>();
    int count = 0;
}

<div class="page-head">
    <div>
        <p class="crumbs"><a href="/Dashboard/Index/">Dashboard</a> / Services</p>
        <h1>Services</h1>
        <p>Services listed in the “Who we are” section.</p>
    </div>
    <a class="btn btn-primary" href="/Service/CreateService/"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add New Service</a>
</div>

<section class="card card-pad" aria-labelledby="list-title">
    <div class="table-toolbar">
        <h2 class="visually-hidden" id="list-title">Services</h2>
        <span class="count">@items.Count @(items.Count == 1 ? "record" : "records")</span>
    </div>
    @if (items.Any())
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th scope="col" class="idx">#</th>
                        <th scope="col">Service Name</th>
                        <th scope="col">Service Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        count++;
                        <tr>
                            <th scope="row" class="idx">@count</th>
                            <td class="title-cell">@item.ServiceName</td>
                            <td>@if (item.ServiceStatus) { <span class="badge badge-success badge-dot">Active</span> } else { <span class="badge badge-muted badge-dot">Passive</span> }</td>
                            <td data-label="Actions"><div class="actions"><a href="/Service/DeleteService/@item.ServiceID" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Delete</a><a href="/Service/UpdateService/@item.ServiceID" class="btn btn-sm btn-ghost"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Update</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-gears" aria-hidden="true"></i>
            <strong>No services yet</strong>
            <p>Add the services your agency offers.</p>
        </div>
    }
</section>
