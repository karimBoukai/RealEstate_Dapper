@model List<RealEstate_Dapper_UI.Dtos.AdsDtos.ResultAdsListDtos>
@{
    ViewData["Title"] = "Ad List";
    Layout = "~/Views/Admin/Index.cshtml";
    var items = Model ?? new List<RealEstate_Dapper_UI.Dtos.AdsDtos.ResultAdsListDtos>();
    int count = 0;
}
@* Delete/Update link to /Product/DeleteProduct and /Product/UpdateProduct as before; ProductController has no such actions yet (see CHANGES.md). *@
<div class="page-head">
    <div>
        <p class="crumbs"><a href="/Dashboard/Index/">Dashboard</a> / Ads</p>
        <h1>Ad List</h1>
        <p>Every advertisement and whether it is shown on the site.</p>
    </div>
    <a class="btn btn-primary" href="/Product/CreateProduct/"><i class="fa-solid fa-plus" aria-hidden="true"></i> New Ad</a>
</div>

<section class="card card-pad" aria-labelledby="list-title">
    <div class="table-toolbar">
        <h2 class="visually-hidden" id="list-title">Ad List</h2>
        <span class="count">@items.Count @(items.Count == 1 ? "ad" : "ads")</span>
    </div>
    @if (items.Any())
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th scope="col" class="idx">#</th>
                        <th scope="col">Advertisement Title</th>
                        <th scope="col">City</th>
                        <th scope="col">District</th>
                        <th scope="col" class="num">Price</th>
                        <th scope="col">Type</th>
                        <th scope="col">Product State</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        count++;
                        <tr>
                            <th scope="row" class="idx">@count</th>
                            <td class="title-cell">@item.Title</td>
                            <td>@item.City</td>
                            <td>@item.District</td>
                            <td class="num">@ViewFormat.Money(item.Price)</td>
                            <td><span class="badge badge-info">@item.Type</span></td>
                            <td data-label="Product State"><div class="actions" style="justify-content:flex-start">@if (item.ProductStatus) { <span class="badge badge-success badge-dot">Active</span> <a href="/Product/ProductAdsPageStatusChangeToFalse/@item.ProductID" class="btn btn-sm btn-ghost">Deactivate</a> } else { <span class="badge badge-muted badge-dot">Passive</span> <a href="/Product/ProductAdsPageStatusChangeToTrue/@item.ProductID" class="btn btn-sm btn-success">Activate</a> }</div></td>
                            <td data-label="Actions"><div class="actions"><a href="/Product/DeleteProduct/@item.ProductID" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Delete</a><a href="/Product/UpdateProduct/@item.ProductID" class="btn btn-sm btn-ghost"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Update</a><a href="@ViewFormat.PropertyUrl(item.SlugUrl, item.Title, item.ProductID)" class="btn btn-sm btn-ghost"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> On The Site</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
            <strong>No ads yet</strong>
            <p>Create your first ad to see it here.</p>
        </div>
    }
</section>
