@model List<ResultCategoryDtos>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Admin/Index.cshtml";
    var items = Model ?? new List<ResultCategoryDtos>();
    int count = 0;
}

<div class="page-head">
    <div>
        <p class="crumbs"><a href="/Dashboard/Index/">Dashboard</a> / Categories</p>
        <h1>Categories</h1>
        <p>Property categories used across listings and search.</p>
    </div>
    <a class="btn btn-primary" href="/Category/CreateCategory/"><i class="fa-solid fa-plus" aria-hidden="true"></i> New Category</a>
</div>

<section class="card card-pad" aria-labelledby="list-title">
    <div class="table-toolbar">
        <h2 class="visually-hidden" id="list-title">Categories</h2>
        <span class="count">@items.Count @(items.Count == 1 ? "record" : "records")</span>
    </div>
    @if (items.Any())
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th scope="col" class="idx">#</th>
                        <th scope="col">Category Name</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        count++;
                        <tr>
                            <th scope="row" class="idx">@item.CategoryID</th>
                            <td class="title-cell">@item.CategoryName</td>
                            <td>@if (item.CategoryStatus) { <span class="badge badge-success badge-dot">Active</span> } else { <span class="badge badge-muted badge-dot">Passive</span> }</td>
                            <td data-label="Actions"><div class="actions"><a href="/Category/DeleteCategory/@item.CategoryID" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Delete</a><a href="/Category/UpdateCategory/@item.CategoryID" class="btn btn-sm btn-ghost"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Update</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
            <strong>No categories yet</strong>
            <p>Create the first category to start organising listings.</p>
        </div>
    }
</section>
