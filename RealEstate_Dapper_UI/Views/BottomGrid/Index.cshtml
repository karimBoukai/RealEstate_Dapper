@model List<RealEstate_Dapper_UI.Dtos.BottomGridDtos.ResultBottomGridDtos>
@{
    ViewData["Title"] = "Bottom Grid";
    Layout = "~/Views/Admin/Index.cshtml";
    var items = Model ?? new List<RealEstate_Dapper_UI.Dtos.BottomGridDtos.ResultBottomGridDtos>();
    int count = 0;
}

<div class="page-head">
    <div>
        <p class="crumbs"><a href="/Dashboard/Index/">Dashboard</a> / Bottom Grid</p>
        <h1>Bottom Grid</h1>
        <p>Highlight cards for the home page.</p>
    </div>
    <a class="btn btn-primary" href="/BottomGrid/CreateBottomGrid/"><i class="fa-solid fa-plus" aria-hidden="true"></i> New Bottom Grid</a>
</div>

<section class="card card-pad" aria-labelledby="list-title">
    <div class="table-toolbar">
        <h2 class="visually-hidden" id="list-title">Bottom Grid</h2>
        <span class="count">@items.Count @(items.Count == 1 ? "record" : "records")</span>
    </div>
    @if (items.Any())
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th scope="col" class="idx">#</th>
                        <th scope="col">Title</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        count++;
                        <tr>
                            <th scope="row" class="idx">@count</th>
                            <td class="title-cell"><i class="@item.Icon" aria-hidden="true" style="color:var(--accent-ink);margin-right:.6rem"></i>@item.Title</td>
                            <td data-label="Actions"><div class="actions"><a href="/BottomGrid/DeleteBottomGrid/@item.BottomGridID" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Delete</a><a href="/BottomGrid/UpdateBottomGrid/@item.BottomGridID" class="btn btn-sm btn-ghost"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Update</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            <strong>No bottom grid items yet</strong>
            <p>Create the first highlight card.</p>
        </div>
    }
</section>
