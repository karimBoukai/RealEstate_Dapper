@model CreateProductDtos
@{
    ViewData["Title"] = "Add New Advert";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="page-head">
    <div>
        <p class="crumbs"><a href="/EstateAgent/MyAdverts/ActiveAdverts/">Active Ads</a> / Add New Advert</p>
        <h1>Add New Advert</h1>
        <p>Publish a new listing under your account.</p>
    </div>
</div>

<section class="card card-pad form-card" aria-labelledby="form-title">
    <h2 class="visually-hidden" id="form-title">Add New Advert</h2>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-grid cols-2">
        <div class="field span-2">
            <label class="field-label" for="Title">Title</label>
            <input type="text" asp-for="Title" class="form-control" />
            <span asp-validation-for="Title"></span>
        </div>
        <div class="field">
            <label class="field-label" for="ProductCategory">Category</label>
            @Html.DropDownListFor(x => x.ProductCategory, (List<SelectListItem>)ViewBag.v, new { @class = "form-select" })
            <span asp-validation-for="ProductCategory"></span>
        </div>
        <div class="field">
            <label class="field-label" for="Price">Price</label>
            <input type="text" asp-for="Price" class="form-control" inputmode="decimal" />
            <span asp-validation-for="Price"></span>
        </div>
        <div class="field">
            <label class="field-label" for="cities">Type</label>
            <select id="cities" asp-for="Type" class="form-select">
                <option value="">---Choose The Type ---</option>
                <option value="Sale">Sale</option>
                <option value="Rent">Rent</option>
            </select>
            <span asp-validation-for="Type"></span>
        </div>
        <div class="field">
            <label class="field-label" for="CoverImage">Choose a cover photo.</label>
            <input type="file" asp-for="CoverImage" class="form-control" />
            <span asp-validation-for="CoverImage"></span>
        </div>
        <div class="field">
            <label class="field-label" for="City">City</label>
            <input type="text" asp-for="City" class="form-control" />
            <span asp-validation-for="City"></span>
        </div>
        <div class="field">
            <label class="field-label" for="District">District</label>
            <input type="text" asp-for="District" class="form-control" />
            <span asp-validation-for="District"></span>
        </div>
        <div class="field span-2">
            <label class="field-label" for="Address">Address</label>
            <textarea asp-for="Address" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Address"></span>
        </div>
        <div class="field span-2">
            <label class="field-label" for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description"></span>
        </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check" aria-hidden="true"></i> Save Ad</button>
            <a href="/EstateAgent/MyAdverts/ActiveAdverts/" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</section>
